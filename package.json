{
  "name": "job-lifecycle-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "db:push": "npm run prisma:push -w backend",
    "db:seed": "npm run prisma:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
