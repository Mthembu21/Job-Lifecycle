DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job_lifecycle?retryWrites=true&w=majority"

# At least 32 random characters. Generate with: npm run secret -w backend
# Changing it signs everyone out.
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Comma-separated list of allowed origins is also supported, e.g.:
# CORS_ORIGIN="http://localhost:5173,https://job-lifecycle-frontend.onrender.com"

# Secret for the TV screen link (/board?key=...). Generate with: npm run secret -w backend
# Leave empty to allow the board only for signed-in users.
BOARD_ACCESS_KEY=""

# Set to "production" when deployed: refuses to start with a weak JWT_SECRET.
# NODE_ENV="production"

# Behind a reverse proxy / load balancer (e.g. Render), set to 1 so login rate limits see real client IPs.
# TRUST_PROXY=1
